{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mystic-mind",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "routes": [
    { "pattern": "mysticmind.co.bw", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/media", "/media/*", "/sitemap.xml", "/admin", "/admin/*"]
  },
  "vars": {
    "CLOUDFLARE_WORKER": "1",
    "PASSWORD_RECOVERY_ENABLED": "1",
    "SITE_ORIGIN": "https://mysticmind.co.bw"
  }
}
